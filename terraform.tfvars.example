# Non-secret example variable values
# Copy this file to terraform.tfvars for local execution
# NEVER commit a real terraform.tfvars with secrets to version control

region          = "ap-southeast-2"
project_name    = "microservice-app"
environment     = "dev"
cluster_version = "1.37"
db_name         = "tasks_db"
db_username     = "postgres"
