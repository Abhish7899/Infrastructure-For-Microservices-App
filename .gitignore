# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform plan output files
*.tfplan

# Ignore override files as they are usually user-specific
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI config files
.terraformrc
terraform.rc

# DO NOT ignore .terraform.lock.hcl (committed for reproducible builds)
!.terraform.lock.hcl
